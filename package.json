{
  "name": "liveblocks",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node dashboard/scripts/run-local.mjs dev",
    "build": "npm --prefix dashboard run build",
    "start": "node dashboard/scripts/run-local.mjs start",
    "test": "npm --prefix dashboard test",
    "typecheck": "npm --prefix dashboard run typecheck",
    "inspect:api": "node --env-file-if-exists=.env dashboard/scripts/python.mjs inspect",
    "setup:python": "npm --prefix dashboard run setup:python"
  }
}
